# Endpoint local do Ollama com API compatível com OpenAI
OPENAI_API_BASE=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=ornith-1.5:9b

# Ajuste de acordo com o contexto configurado no modelo/servidor.
# Com Ollama, o harness detecta o contexto real alocado e reduz este valor se preciso;
# para ampliar o contexto, inicie o Ollama com OLLAMA_CONTEXT_LENGTH=<tokens>.
HARNEASY_CONTEXT_WINDOW=4200
HARNEASY_COMPACT_TOTAL=0.85
HARNEASY_COMPACT_AT=0.55
HARNEASY_MAX_TOOL_OUTPUT_CHARS=6000

# Cliente do modelo: novas tentativas em erro de conexão/5xx e timeout (s)
HARNEASY_LLM_MAX_RETRIES=3
HARNEASY_LLM_TIMEOUT=600

# Limites de execução
HARNEASY_COMMAND_TIMEOUT=60
HARNEASY_MAX_TURNS_PER_REQUEST=30
HARNEASY_MAX_TOOL_CALLS_PER_TURN=8
HARNEASY_REPEAT_TOOL_LIMIT=3
HARNEASY_SUBAGENT_MAX_TURNS=10
HARNEASY_SUBAGENT_MAX_TOOL_CALLS_PER_TURN=5

# Ative para bloquear shell quando não houver sandbox do sistema operacional
HARNEASY_REQUIRE_SANDBOX=0

# Comportamento do modelo
HARNEASY_TEMPERATURE=0
HARNEASY_SEED=42
HARNEASY_STREAM=1
HARNEASY_MAX_NUDGES=2
# HARNEASY_DEBUG_LOG=llm_output.jsonl

# Verificação feita pelo harness quando o agente diz que terminou.
# Sem valor: pytest em projetos com testes. "off" desliga.
# HARNEASY_VERIFY_COMMAND=python -m pytest -q
HARNEASY_MAX_VERIFY=2
HARNEASY_FINAL_REVIEW=1
HARNEASY_AUTO_SKILLS=1

# Esconda ferramentas que o modelo usa mal (separadas por vírgula)
# HARNEASY_DISABLED_TOOLS=task

# Busca por significado (modelo de embedding servido pelo mesmo endpoint)
# HARNEASY_EMBED_MODEL=embeddinggemma
